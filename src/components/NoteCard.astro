---
interface Props { title: string; href: string; date: Date; description?: string; }
const { title, href, date, description } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
---
<a href={href} style="display:block; padding:14px 0; border-bottom:0.5px solid var(--border); text-decoration:none; color:inherit;">
  <div style="font-size:16px; color:var(--text);">{title}</div>
  {description && <div style="font-size:13px; color:var(--text-muted); margin-top:4px;">{description}</div>}
  <time datetime={dateStr} style="font-size:12px; color:var(--text-dim);">{dateStr}</time>
</a>
