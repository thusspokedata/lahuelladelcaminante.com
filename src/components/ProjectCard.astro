---
interface Props {
  name: string;
  description: string;
  url: string;
  tags: string[];
}
const { name, description, url, tags } = Astro.props;
---
<a
  href={url}
  target="_blank"
  rel="noopener"
  style="display:block; background:var(--surface); border:0.5px solid var(--border); border-radius:var(--radius); padding:16px; text-decoration:none; color:inherit;"
>
  <div style="font-size:16px; color:var(--text); margin-bottom:6px; font-weight:500;">{name}</div>
  <p style="font-size:13px; color:var(--text-muted); margin:0 0 12px; line-height:1.55;">{description}</p>
  <div style="display:flex; gap:6px; flex-wrap:wrap;">
    {tags.map((tag) => (
      <span style="font-size:11px; background:var(--chip-bg); color:var(--accent-light); border-radius:4px; padding:2px 8px;">{tag}</span>
    ))}
  </div>
</a>
