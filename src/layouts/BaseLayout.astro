---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  alternateUrl?: string;
}

const { title, description = '' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <main id="main" class="container" style="padding-block: 2.5rem 4rem;">
      <slot />
    </main>
  </body>
</html>
