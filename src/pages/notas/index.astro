---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
const notes = (await getCollection('notes'))
  .filter((n) => n.data.lang === 'es' && !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="Notas — La Huella del Caminante" alternateUrl="/en/notes">
  <h1 style="font-size:30px; font-weight:500; margin:0 0 20px;">{t('notes.title')}<span style="color:var(--accent);">.</span></h1>
  {notes.length === 0 && <p style="color:var(--text-muted);">{t('notes.empty')}</p>}
  {notes.map((n) => (
    <NoteCard title={n.data.title} href={`/notas/${n.id.split('/').pop()}`} date={n.data.date} description={n.data.description} />
  ))}
</BaseLayout>
